[Desktop Entry]
Type=Application
Name=kith
GenericName=Chat client
Comment=A terminal chat client for Matrix, WhatsApp, Telegram and Slack
# Hands matrix: URIs to the running kith over the daemon socket.
Exec=kith --open %u
Terminal=false
NoDisplay=true
MimeType=x-scheme-handler/matrix;
Categories=Network;InstantMessaging;
Keywords=matrix;chat;
