# Indentation for the files gofmt does not reach.
#
# `make fmt` settles every .go file and nothing else, so YAML, shell, TOML and
# Markdown were whatever each editor happened to insert. This states the answer once
# rather than in each contributor's config — see CONTRIBUTING.md.
#
# Editors that do not read this file are not a problem: nothing here is enforced by a
# gate, because a tab in a YAML file is a parse error the CI already catches and a
# two-space shell indent is not worth failing a build over.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4

# gofmt's own rules, restated so an editor does not fight it before it runs.
[*.go]
indent_style = tab
indent_size = 4

# YAML cannot be indented with tabs at all — it is a parse error, not a style.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

# Tabs, matching scripts/ and .githooks/. A here-doc keeps whatever is in it, so a
# script that prints indented text uses spaces inside the here-doc on purpose.
[*.sh]
indent_style = tab
indent_size = 4

# Recipe lines *must* begin with a tab; make has no other way to read them.
[Makefile]
indent_style = tab
indent_size = 4

# Two spaces, because a nested list item indented with a tab renders as a code block
# in some viewers. Trailing whitespace stays trimmed: a hard line break written as
# two trailing spaces is invisible, and a backslash says the same thing out loud.
[*.md]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 2

# Generated by buf/protoc-gen-*; nothing here should be reformatted by hand.
[*.{pb.go,connect.go}]
trim_trailing_whitespace = false
